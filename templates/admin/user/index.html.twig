{% extends 'admin/base_admin.html.twig' %}

{% block title %}Utilisateurs — Admin{% endblock %}

{% block admin_content %}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="fw-bold mb-0"><i class="bi bi-people me-2"></i>Utilisateurs</h4>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Nom complet</th>
                    <th>Email</th>
                    <th>Rôle</th>
                    <th>Vérifié</th>
                    <th>Inscription</th>
                    <th>Commandes</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for utilisateur in utilisateurs %}
                <tr>
                    <td class="text-muted">{{ utilisateur.id }}</td>
                    <td class="fw-bold">{{ utilisateur.nomComplet }}</td>
                    <td>{{ utilisateur.email }}</td>
                    <td>
                        {% if 'ROLE_ADMIN' in utilisateur.roles %}
                            <span class="badge bg-danger">Admin</span>
                        {% else %}
                            <span class="badge bg-secondary">Utilisateur</span>
                        {% endif %}
                    </td>
                    <td>
                        {% if utilisateur.verified %}
                            <i class="bi bi-check-circle-fill text-success"></i>
                        {% else %}
                            <i class="bi bi-x-circle-fill text-danger"></i>
                        {% endif %}
                    </td>
                    <td>{{ utilisateur.createdAt|date('d/m/Y') }}</td>
                    <td>
                        <span class="badge bg-info">{{ utilisateur.commandes|length }}</span>
                    </td>
                    <td>
                        {% if utilisateur != app.user %}
                        <form method="post" action="{{ path('admin_user_toggle', {id: utilisateur.id}) }}"
                              style="display:inline"
                              onsubmit="return confirm('Modifier le rôle de cet utilisateur ?')">
                            <input type="hidden" name="_token" value="{{ csrf_token('toggle-user-' ~ utilisateur.id) }}">
                            {% if 'ROLE_ADMIN' in utilisateur.roles %}
                                <button type="submit" class="btn btn-outline-warning btn-sm">
                                    <i class="bi bi-arrow-down me-1"></i>Rétrograder
                                </button>
                            {% else %}
                                <button type="submit" class="btn btn-outline-success btn-sm">
                                    <i class="bi bi-arrow-up me-1"></i>Promouvoir Admin
                                </button>
                            {% endif %}
                        </form>
                        {% else %}
                            <span class="text-muted small">Vous</span>
                        {% endif %}
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="8" class="text-center text-muted py-4">Aucun utilisateur.</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
