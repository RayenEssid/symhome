{% extends 'admin/base_admin.html.twig' %}

{% block title %}Catégories — Admin{% endblock %}

{% block admin_content %}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="fw-bold mb-0"><i class="bi bi-tags me-2"></i>Catégories</h4>
    <a href="{{ path('admin_categorie_create') }}" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-lg me-1"></i>Nouvelle catégorie
    </a>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Nom</th>
                    <th>Slug</th>
                    <th>Description</th>
                    <th>Meubles</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for categorie in categories %}
                <tr>
                    <td class="text-muted">{{ categorie.id }}</td>
                    <td class="fw-bold">{{ categorie.nom }}</td>
                    <td><code>{{ categorie.slug }}</code></td>
                    <td class="text-muted">
                        {% set desc = categorie.description|default('') %}
                        {{ desc|slice(0, 60) }}{{ desc|length > 60 ? '…' : '' }}
                        {% if not desc %}—{% endif %}
                    </td>
                    <td>
                        <span class="badge bg-secondary">{{ categorie.meubles|length }}</span>
                    </td>
                    <td>
                        <a href="{{ path('admin_categorie_edit', {id: categorie.id}) }}"
                           class="btn btn-outline-primary btn-sm me-1">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <form method="post" action="{{ path('admin_categorie_delete', {id: categorie.id}) }}"
                              style="display:inline"
                              onsubmit="return confirm('Supprimer cette catégorie ?')">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete-cat-' ~ categorie.id) }}">
                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="6" class="text-center text-muted py-4">Aucune catégorie.</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
