{% extends 'admin/base_admin.html.twig' %}

{% block title %}Commandes — Admin{% endblock %}

{% block admin_content %}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="fw-bold mb-0"><i class="bi bi-cart-check me-2"></i>Commandes</h4>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Numéro</th>
                    <th>Client</th>
                    <th>Date</th>
                    <th>Total</th>
                    <th>Statut</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for commande in commandes %}
                <tr>
                    <td class="fw-bold">{{ commande.numero }}</td>
                    <td>{{ commande.user.nomComplet }}<br>
                        <small class="text-muted">{{ commande.user.email }}</small>
                    </td>
                    <td>{{ commande.createdAt|date('d/m/Y H:i') }}</td>
                    <td class="fw-bold">{{ commande.total }} TND</td>
                    <td>
                        <span class="badge bg-{{ commande.statutBadgeClass }}">
                            {{ commande.statutLabel }}
                        </span>
                    </td>
                    <td>
                        <a href="{{ path('admin_commande_edit', {id: commande.id}) }}"
                           class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-pencil me-1"></i>Modifier statut
                        </a>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="6" class="text-center text-muted py-4">Aucune commande.</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
