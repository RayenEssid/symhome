{% extends 'base.html.twig' %}
{% block title %}Connexion — SymHome{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card">
            <div class="card-body p-4">
                <h2 class="text-center mb-4"><i class="bi bi-person-lock me-2"></i>Connexion</h2>

                {% if error %}
                    <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                {% endif %}

                <form method="post" action="{{ path('app_login') }}">
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input class="form-control" type="email" name="email" value="{{ last_username }}" autofocus required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Mot de passe</label>
                        <input class="form-control" type="password" name="password" required>
                    </div>
                    <div class="mb-3 form-check">
                        <input class="form-check-input" type="checkbox" name="_remember_me" id="rememberMe">
                        <label class="form-check-label" for="rememberMe">Se souvenir de moi</label>
                    </div>
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                    <button type="submit" class="btn btn-primary w-100 btn-lg">Se connecter</button>
                </form>

                <hr>
                <p class="text-center mb-0">
                    Pas encore de compte ? <a href="{{ path('app_register') }}">Créer un compte</a>
                </p>
            </div>
        </div>
        <div class="text-center mt-3 text-muted small">
            <strong>Compte de test :</strong> user@symhome.com / user123<br>
            <strong>Admin :</strong> admin@symhome.com / admin123
        </div>
    </div>
</div>
{% endblock %}
