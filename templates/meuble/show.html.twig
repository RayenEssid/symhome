
{% extends 'base.html.twig' %}
{% block title %}{{ meuble.nom }} — SymHome{% endblock %}
{% block body %}
<div class="row">
    <div class="col-md-5">
        {% if meuble.image %}
            <img src="{{ asset('uploads/meubles/' ~ meuble.image) }}"
                 class="img-fluid rounded shadow" alt="{{ meuble.nom }}">
        {% else %}
            <div class="bg-light d-flex align-items-center justify-content-center rounded"
                 style="height:350px;">
                <i class="bi bi-image text-muted" style="font-size:5rem;"></i>
            </div>
        {% endif %}
    </div>
    <div class="col-md-7">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('app_meuble_index') }}">Catalogue</a></li>
                <li class="breadcrumb-item active">{{ meuble.nom }}</li>
            </ol>
        </nav>
        <span class="badge bg-secondary mb-2">{{ meuble.categorie.nom }}</span>
        <h1>{{ meuble.nom }}</h1>
        <p class="lead text-muted">{{ meuble.description }}</p>
        <hr>
        <div class="d-flex align-items-center gap-3 mb-4">
            <span class="fs-2 fw-bold text-primary">{{ meuble.prix|number_format(2, ',', ' ') }} €</span>
            {% if meuble.stock > 0 %}
                <span class="badge bg-success">En stock ({{ meuble.stock }})</span>
            {% else %}
                <span class="badge bg-danger">Rupture de stock</span>
            {% endif %}
        </div>
        {% if meuble.stock > 0 %}
            <form method="post" action="{{ path('app_panier_ajouter', {id: meuble.id}) }}"
                  class="d-flex gap-2 align-items-center">
                <input type="number" name="quantite" value="1" min="1" max="{{ meuble.stock }}"
                       class="form-control" style="width:80px;">
                <button class="btn btn-primary btn-lg" type="submit">
                    <i class="bi bi-cart-plus"></i> Ajouter au panier
                </button>
            </form>
        {% endif %}
    </div>
</div>
{% endblock %}