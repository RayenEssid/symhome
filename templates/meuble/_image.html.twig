{# Partial réutilisable — affiche l'image d'un meuble ou un placeholder #}
{% set fallbackImage = '/images/meuble-tv.jpg' %}
{% if meuble.categorie is defined and meuble.categorie %}
    {% set fallbackImage = {
        sejour: '/images/canape.jpg',
        chambre: '/images/lit.jpg',
        bureau: '/images/bureau.jpg',
        cuisine: '/images/table-cuisine.jpg'
    }[meuble.categorie.slug]|default('/images/meuble-tv.jpg') %}
{% endif %}

{% if meuble.image %}
    {% if meuble.image starts with 'http' or meuble.image starts with '/' %}
        <img src="{{ meuble.image }}" alt="{{ meuble.nom }}"
             class="{{ imgClass|default('img-fluid') }}"
             style="{{ imgStyle|default('') }}"
             onerror="this.onerror=null;this.src='{{ fallbackImage }}';">
    {% else %}
        <img src="/uploads/meubles/{{ meuble.image }}" alt="{{ meuble.nom }}"
             class="{{ imgClass|default('img-fluid') }}"
             style="{{ imgStyle|default('') }}"
             onerror="this.onerror=null;this.src='{{ fallbackImage }}';">
    {% endif %}
{% else %}
    <img src="{{ fallbackImage }}" alt="{{ meuble.nom }}"
         class="{{ imgClass|default('img-fluid') }}"
         style="{{ imgStyle|default('') }}">
{% endif %}
