{% extends 'base.html.twig' %}
{% block title %}Catalogue — SymHome{% endblock %}

{% block body %}
<div class="row">
    {# Sidebar filtres #}
    <div class="col-lg-3 mb-4">
        <div class="card p-3">
            <h5><i class="bi bi-funnel me-1"></i>Filtres</h5>
            <form method="get">
                <div class="mb-3">
                    <label class="form-label fw-bold">Recherche</label>
                    <input type="text" name="q" class="form-control" value="{{ search }}" placeholder="Nom, description...">
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Catégorie</label>
                    <select name="categorie" class="form-select">
                        <option value="">Toutes</option>
                        {% for cat in categories %}
                            <option value="{{ cat.slug }}" {% if categorieSlug == cat.slug %}selected{% endif %}>{{ cat.nom }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="mb-2">
                    <label class="form-label fw-bold">Prix</label>
                    <div class="d-flex gap-2">
                        <input type="number" name="prix_min" class="form-control" placeholder="Min" value="{{ prix_min }}">
                        <input type="number" name="prix_max" class="form-control" placeholder="Max" value="{{ prix_max }}">
                    </div>
                </div>
                <button type="submit" class="btn btn-primary w-100">Filtrer</button>
                <a href="{{ path('app_meuble_index') }}" class="btn btn-outline-secondary w-100 mt-2">Réinitialiser</a>
            </form>
        </div>
    </div>

    {# Grille produits #}
    <div class="col-lg-9">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4>{{ meubles|length }} résultat(s){% if search %} pour "{{ search }}"{% endif %}</h4>
        </div>

        {% if meubles is empty %}
            <div class="alert alert-info">Aucun meuble trouvé avec ces critères.</div>
        {% else %}
            <div class="row g-3">
                {% for meuble in meubles %}
                <div class="col-sm-6 col-xl-4">
                    <div class="card h-100">
                        <div class="card-img-top bg-light overflow-hidden" style="height:150px">
                            {% include 'meuble/_image.html.twig' with {imgClass: 'img-fluid w-100', imgStyle: 'object-fit:cover;height:150px'} %}
                        </div>
                        <div class="card-body d-flex flex-column">
                            <small class="text-muted">{{ meuble.categorie.nom }}</small>
                            <h6 class="card-title mt-1">{{ meuble.nom }}</h6>
                            <p class="card-text text-muted small">{{ meuble.description|slice(0, 80) }}{% if meuble.description|length > 80 %}...{% endif %}</p>
                            <div class="mt-auto">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <strong class="fs-5 text-primary">{{ meuble.prix }} TND</strong>
                                    {% if meuble.stock > 0 %}
                                        <span class="badge bg-success">En stock ({{ meuble.stock }})</span>
                                    {% else %}
                                        <span class="badge bg-danger">Rupture</span>
                                    {% endif %}
                                </div>
                                <a href="{{ path('app_meuble_show', {id: meuble.id}) }}" class="btn btn-primary w-100 btn-sm">
                                    <i class="bi bi-eye me-1"></i>Voir le produit
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
