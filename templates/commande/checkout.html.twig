{% extends 'base.html.twig' %}
{% block title %}Finaliser ma commande — SymHome{% endblock %}

{% block body %}
<h2 class="fw-bold mb-4"><i class="bi bi-bag-check me-2"></i>Finaliser la commande</h2>

<div class="row g-4">

    {# ── Récapitulatif panier ── #}
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header fw-bold">Récapitulatif de votre panier</div>
            <div class="card-body p-0">
                <table class="table mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Meuble</th>
                            <th>Prix unitaire</th>
                            <th>Qté</th>
                            <th class="text-end">Sous-total</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in items %}
                        <tr>
                            <td class="fw-bold">{{ item.meuble.nom }}</td>
                            <td>{{ item.meuble.prix }} TND</td>
                            <td>{{ item.quantite }}</td>
                            <td class="text-end">{{ item.sousTotal|number_format(2, ',', ' ') }} TND</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                    <tfoot>
                        <tr class="table-light">
                            <td colspan="3" class="fw-bold text-end">Total</td>
                            <td class="fw-bold text-end text-primary fs-5">{{ total|number_format(2, ',', ' ') }} TND</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    {# ── Formulaire adresse ── #}
    <div class="col-lg-5">
        <div class="card">
            <div class="card-header fw-bold">Adresse de livraison</div>
            <div class="card-body">
                {{ form_start(form) }}
                    {{ form_row(form.adresseLivraison) }}
                    <hr>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="fw-bold">Total à régler :</span>
                        <span class="fs-4 fw-bold text-primary">{{ total|number_format(2, ',', ' ') }} TND</span>
                    </div>
                    {{ form_widget(form.valider) }}
                {{ form_end(form) }}
            </div>
        </div>
        <a href="{{ path('app_panier_index') }}" class="btn btn-outline-secondary w-100 mt-2">
            <i class="bi bi-arrow-left me-1"></i>Retour au panier
        </a>
    </div>

</div>
{% endblock %}
