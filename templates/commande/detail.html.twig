{% extends 'base.html.twig' %}
{% block title %}Commande {{ commande.numero }} — SymHome{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Commande <strong>{{ commande.numero }}</strong></h1>
    <span class="badge bg-{{ commande.statutBadgeClass }} fs-6">{{ commande.statutLabel }}</span>
</div>

<div class="row g-4">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header"><strong>Articles commandés</strong></div>
            <div class="card-body p-0">
                <table class="table mb-0">
                    <thead class="table-light">
                        <tr><th>Produit</th><th>Prix</th><th>Qté</th><th>Sous-total</th></tr>
                    </thead>
                    <tbody>
                        {% for ligne in commande.lignesCommande %}
                        <tr>
                            <td>{{ ligne.meuble.nom }}</td>
                            <td>{{ ligne.prixUnitaire }} TND</td>
                            <td>{{ ligne.quantite }}</td>
                            <td><strong>{{ ligne.sousTotal|number_format(2, ',', ' ') }} TND</strong></td>
                        </tr>
                        {% endfor %}
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <td colspan="3" class="text-end fw-bold">Total</td>
                            <td><strong class="text-primary fs-5">{{ commande.total }} TND</strong></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h6>Informations</h6>
                <dl class="mb-0">
                    <dt class="text-muted small">Date</dt>
                    <dd>{{ commande.createdAt|date('d/m/Y à H:i') }}</dd>
                    <dt class="text-muted small">Statut</dt>
                    <dd><span class="badge bg-{{ commande.statutBadgeClass }}">{{ commande.statutLabel }}</span></dd>
                </dl>
            </div>
        </div>
    </div>
</div>

<a href="{{ path('app_commande_historique') }}" class="btn btn-outline-secondary mt-3">
    <i class="bi bi-arrow-left me-1"></i>Retour
</a>
{% endblock %}
