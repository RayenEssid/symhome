{% extends 'base.html.twig' %}
{% block title %}Commande confirmée — SymHome{% endblock %}

{% block body %}
<div class="text-center py-5">
    <div class="mb-4">
        <i class="bi bi-check-circle-fill text-success" style="font-size:5rem"></i>
    </div>
    <h1 class="text-success">Commande confirmée !</h1>
    <p class="lead text-muted">Merci pour votre achat, {{ app.user.prenom }} !</p>

    <div class="card mx-auto mt-4" style="max-width:500px">
        <div class="card-body">
            <h5>Commande <strong>{{ commande.numero }}</strong></h5>
            <p class="text-muted">Date : {{ commande.createdAt|date('d/m/Y à H:i') }}</p>
            <hr>
            {% for ligne in commande.lignesCommande %}
            <div class="d-flex justify-content-between">
                <span>{{ ligne.meuble.nom }} × {{ ligne.quantite }}</span>
                <strong>{{ ligne.sousTotal|number_format(2, ',', ' ') }} TND</strong>
            </div>
            {% endfor %}
            <hr>
            <div class="d-flex justify-content-between fs-5 fw-bold">
                <span>Total payé</span>
                <span class="text-success">{{ commande.total }} TND</span>
            </div>
        </div>
    </div>

    <div class="mt-4 d-flex justify-content-center gap-3">
        <a href="{{ path('app_commande_historique') }}" class="btn btn-outline-primary">Mes commandes</a>
        <a href="{{ path('app_meuble_index') }}" class="btn btn-primary">Continuer mes achats</a>
    </div>
</div>
{% endblock %}
