{% extends 'base.html.twig' %}
{% block title %}Mon panier — SymHome{% endblock %}

{% block body %}
<h1 class="mb-4"><i class="bi bi-cart3 me-2"></i>Mon panier</h1>

{% if items is empty %}
    <div class="text-center py-5">
        <i class="bi bi-cart-x text-muted" style="font-size:4rem"></i>
        <h4 class="mt-3 text-muted">Votre panier est vide</h4>
        <a href="{{ path('app_meuble_index') }}" class="btn btn-primary mt-3">Découvrir le catalogue</a>
    </div>
{% else %}
<div class="row g-4">
    <div class="col-lg-8">
        {% for item in items %}
        <div class="card mb-3">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-2 text-center">
                        <div class="rounded bg-light overflow-hidden" style="height:70px">
                            {% include 'meuble/_image.html.twig' with {
                                meuble: item.meuble,
                                imgClass: 'img-fluid w-100',
                                imgStyle: 'object-fit:cover;height:70px'
                            } %}
                        </div>
                    </div>
                    <div class="col-5">
                        <h6 class="mb-1">{{ item.meuble.nom }}</h6>
                        <small class="text-muted">{{ item.meuble.categorie.nom }}</small><br>
                        <small class="text-primary fw-bold">{{ item.meuble.prix }} TND / unité</small>
                    </div>
                    <div class="col-3">
                        <form action="{{ path('app_panier_modifier', {id: item.meuble.id}) }}" method="post" class="d-flex align-items-center gap-1">
                            <input type="number" name="quantite" class="form-control form-control-sm" value="{{ item.quantite }}" min="0" max="{{ item.meuble.stock }}" style="width:60px" onchange="this.form.submit()">
                        </form>
                    </div>
                    <div class="col-2 text-end">
                        <strong class="text-primary">{{ item.sousTotal|number_format(2, ',', ' ') }} TND</strong><br>
                        <a href="{{ path('app_panier_supprimer', {id: item.meuble.id}) }}" class="btn btn-sm btn-outline-danger mt-1">
                            <i class="bi bi-trash"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
        {% endfor %}
        <a href="{{ path('app_panier_vider') }}" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-trash me-1"></i>Vider le panier
        </a>
    </div>

    <div class="col-lg-4">
        <div class="card">
            <div class="card-body">
                <h5>Récapitulatif</h5>
                <hr>
                {% for item in items %}
                    <div class="d-flex justify-content-between text-muted small mb-1">
                        <span>{{ item.meuble.nom }} × {{ item.quantite }}</span>
                        <span>{{ item.sousTotal|number_format(2, ',', ' ') }} TND</span>
                    </div>
                {% endfor %}
                <hr>
                <div class="d-flex justify-content-between fw-bold fs-5">
                    <span>Total</span>
                    <span class="text-primary">{{ total|number_format(2, ',', ' ') }} TND</span>
                </div>
                <hr>
                {% if app.user %}
                    <a href="{{ path('app_commande_checkout') }}" class="btn btn-primary w-100 btn-lg">
                        <i class="bi bi-credit-card me-2"></i>Commander
                    </a>
                {% else %}
                    <a href="{{ path('app_login') }}" class="btn btn-primary w-100 btn-lg">
                        <i class="bi bi-person me-2"></i>Connexion pour commander
                    </a>
                {% endif %}
                <a href="{{ path('app_meuble_index') }}" class="btn btn-outline-primary w-100 mt-2">
                    <i class="bi bi-arrow-left me-2"></i>Continuer mes achats
                </a>
            </div>
        </div>
    </div>
</div>
{% endif %}
{% endblock %}
