{% extends 'base.html.twig' %}

{% block title %}SymHome — Accueil{% endblock %}

{% block body %}
{# Hero #}
<div class="p-5 mb-4 rounded-3 text-white" style="background: linear-gradient(135deg, #2d5a27, #4a8c42);">
    <div class="py-3">
        <h1 class="display-5 fw-bold"><i class="bi bi-house-heart me-2"></i>Bienvenue chez SymHome</h1>
        <p class="lead">Découvrez notre collection de meubles et décorations pour votre intérieur.</p>
        <a href="{{ path('app_meuble_index') }}" class="btn btn-light btn-lg">
            <i class="bi bi-grid me-1"></i>Voir le catalogue
        </a>
    </div>
</div>

{# Catégories #}
<h2 class="mb-3">Nos catégories</h2>
<div class="row g-3 mb-5">
    {% for categorie in categories %}
    <div class="col-sm-6 col-lg-3">
        <a href="{{ path('app_meuble_index', {categorie: categorie.slug}) }}" class="text-decoration-none">
            <div class="card h-100 text-center p-3">
                <div class="fs-1 mb-2">
                    {% if categorie.slug == 'sejour' %}🛋️
                    {% elseif categorie.slug == 'chambre' %}🛏️
                    {% elseif categorie.slug == 'bureau' %}💼
                    {% else %}🍳
                    {% endif %}
                </div>
                <h5 class="card-title text-dark">{{ categorie.nom }}</h5>
                <small class="text-muted">{{ categorie.meubles|length }} article(s)</small>
            </div>
        </a>
    </div>
    {% endfor %}
</div>

{# Nouveautés #}
<h2 class="mb-3">Nouveautés</h2>
<div class="row g-3">
    {% for meuble in meubles_vedette %}
    <div class="col-sm-6 col-lg-3">
        <div class="card h-100">
            <div class="card-img-top bg-light d-flex align-items-center justify-content-center overflow-hidden" style="height:160px">
                {% include 'meuble/_image.html.twig' with {imgClass: 'img-fluid w-100', imgStyle: 'object-fit:cover;height:160px'} %}
            </div>
            <div class="card-body d-flex flex-column">
                <small class="text-muted mb-1">{{ meuble.categorie.nom }}</small>
                <h6 class="card-title">{{ meuble.nom }}</h6>
                <div class="mt-auto d-flex justify-content-between align-items-center">
                    <strong class="text-primary fs-5">{{ meuble.prix }} TND</strong>
                    <a href="{{ path('app_meuble_show', {id: meuble.id}) }}" class="btn btn-sm btn-outline-primary">Voir</a>
                </div>
            </div>
        </div>
    </div>
    {% endfor %}
</div>
{% endblock %}
