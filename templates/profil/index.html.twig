{% extends 'base.html.twig' %}
{% block title %}Mon profil — SymHome{% endblock %}

{% block body %}
<div class="row g-4">

    {# ── Infos utilisateur ── #}
    <div class="col-md-4">
        <div class="card text-center">
            <div class="card-body py-4">
                <i class="bi bi-person-circle text-primary" style="font-size:4rem"></i>
                <h5 class="mt-3 fw-bold">{{ app.user.nomComplet }}</h5>
                <p class="text-muted mb-1">{{ app.user.email }}</p>
                {% if 'ROLE_ADMIN' in app.user.roles %}
                    <span class="badge bg-danger">Administrateur</span>
                {% else %}
                    <span class="badge bg-secondary">Client</span>
                {% endif %}
                <p class="text-muted small mt-2">Membre depuis {{ app.user.createdAt|date('d/m/Y') }}</p>
            </div>
        </div>

        {# ── Changer mot de passe (TP5 : FormType + validation) ── #}
        <div class="card mt-3">
            <div class="card-header fw-bold">
                <i class="bi bi-lock me-1"></i>Changer le mot de passe
            </div>
            <div class="card-body">
                {{ form_start(form) }}
                    {{ form_row(form.plainPassword.first) }}
                    {{ form_row(form.plainPassword.second) }}
                    <hr>
                    {{ form_widget(form.sauvegarder) }}
                {{ form_end(form) }}
            </div>
        </div>
    </div>

    {# ── Historique commandes ── #}
    <div class="col-md-8">
        <div class="card">
            <div class="card-header fw-bold">
                <i class="bi bi-clock-history me-1"></i>Mes commandes ({{ commandes|length }})
            </div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Numéro</th>
                            <th>Date</th>
                            <th>Total</th>
                            <th>Statut</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for commande in commandes %}
                        <tr>
                            <td class="fw-bold">{{ commande.numero }}</td>
                            <td>{{ commande.createdAt|date('d/m/Y') }}</td>
                            <td>{{ commande.total }} TND</td>
                            <td>
                                <span class="badge bg-{{ commande.statutBadgeClass }}">
                                    {{ commande.statutLabel }}
                                </span>
                            </td>
                            <td>
                                <a href="{{ path('app_commande_detail', {id: commande.id}) }}"
                                   class="btn btn-sm btn-outline-primary">
                                    Détail
                                </a>
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">
                                Aucune commande pour l'instant.
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>
{% endblock %}
